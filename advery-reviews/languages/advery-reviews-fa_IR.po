msgstr "ایمیلِ نویسنده"

#: build/index.js:2
msgid "Review text"
msgstr "متنِ نظر"

#: build/index.js:2
msgid "Date"
msgstr "تاریخ"

#: build/index.js:2
msgid "Default status"
msgstr "وضعیتِ پیش‌فرض"

#: build/index.js:2
msgid "Update reviews already imported (same source + id)"
msgstr "به‌روزرسانیِ نظراتِ قبلاً درون‌ریزی‌شده (همان منبع + شناسه)"

#: build/index.js:2
msgid "Without a unique id column, re-imports can create duplicates."
msgstr "بدونِ ستونِ شناسه‌ی یکتا، درون‌ریزیِ مجدد ممکن است تکراری بسازد."

#: build/index.js:2
msgid "Load a file and choose the target column first."
msgstr "اول یک فایل بارگذاری کنید و ستونِ هدف را انتخاب کنید."

#: build/index.js:2
#, js-format
msgid "Imported %1$d, updated %2$d, skipped %3$d."
msgstr "درون‌ریزی %1$d، به‌روزرسانی %2$d، ردشده %3$d."

#: build/index.js:2
msgid "Import rows"
msgstr "درون‌ریزیِ ردیف‌ها"

#: build/index.js:2
#, js-format
msgid "imported %1$d, updated %2$d, skipped %3$d…"
msgstr "درون‌ریزی %1$d، به‌روزرسانی %2$d، ردشده %3$d…"

#: build/index.js:2
msgid "Move reviews in and out of Advery Reviews. Everything here is safe to run more than once — imports copy your data and never create duplicates."
msgstr "نظرات را به Advery Reviews وارد یا از آن خارج کنید. همه‌چیزِ اینجا برای اجرای چندباره امن است — درون‌ریزی‌ها داده‌ی شما را کپی می‌کنند و هرگز تکراری نمی‌سازند."

#: build/index.js:2
msgid "Import existing comments"
msgstr "درون‌ریزیِ کامنت‌های موجود"

#: build/index.js:2
msgid "Bring your current WordPress comments and WooCommerce reviews into Advery Reviews. Your originals stay in place, and running this again only updates — it never duplicates."
msgstr "کامنت‌های فعلیِ وردپرس و نظراتِ ووکامرس را به Advery Reviews بیاورید. نسخه‌های اصلی سرِ جایشان می‌مانند و اجرای دوباره فقط به‌روزرسانی می‌کند — هرگز تکراری نمی‌سازد."

#: build/index.js:2
#, js-format
msgid "%d WordPress comments"
msgstr "%d کامنتِ وردپرس"

#: build/index.js:2
#, js-format
msgid "%d WooCommerce reviews"
msgstr "%d نظرِ ووکامرس"

#: build/index.js:2
#, js-format
msgid "%d already imported"
msgstr "%d از قبل درون‌ریزی‌شده"

#: build/index.js:2
#, js-format
msgid "Include WordPress post comments (%d)"
msgstr "شاملِ کامنت‌های نوشته‌ی وردپرس (%d)"

#: build/index.js:2
#, js-format
msgid "Include WooCommerce product reviews (%d)"
msgstr "شاملِ نظراتِ محصولِ ووکامرس (%d)"

#: build/index.js:2
msgid "Update items already imported"
msgstr "به‌روزرسانیِ آیتم‌های قبلاً درون‌ریزی‌شده"

#: build/index.js:2
msgid "On: re-importing refreshes reviews you imported before. Off: they’re skipped."
msgstr "روشن: درون‌ریزیِ مجدد نظراتی که قبلاً وارد کردید را تازه می‌کند. خاموش: رد می‌شوند."

#: build/index.js:2
msgid "Delete the original comments after importing"
msgstr "حذفِ کامنت‌های اصلی پس از درون‌ریزی"

#: build/index.js:2
msgid "Off (recommended): keep a copy in the comment tables. On: permanently remove the source comments once imported."
msgstr "خاموش (توصیه‌شده): یک نسخه در جدول‌های کامنت نگه دارید. روشن: کامنت‌های منبع پس از درون‌ریزی برای همیشه حذف می‌شوند."

#: build/index.js:2
msgid "The original comments will be permanently deleted after import."
msgstr "کامنت‌های اصلی پس از درون‌ریزی برای همیشه حذف خواهند شد."

#: build/index.js:2
msgid "Delete the source comments after importing? This cannot be undone."
msgstr "کامنت‌های منبع بعد از درون‌ریزی حذف شوند؟ این کار قابلِ بازگشت نیست."

#: build/index.js:2
msgid "Import now"
msgstr "همین حالا درون‌ریزی کن"

#: build/index.js:2
#, js-format
msgid "imported %1$d · updated %2$d · skipped %3$d…"
msgstr "درون‌ریزی %1$d · به‌روزرسانی %2$d · ردشده %3$d…"

#: build/index.js:2
msgid "Export reviews back to comments"
msgstr "برون‌بریِ نظرات به کامنت‌ها"

#: build/index.js:2
msgid "Recreate native WordPress / WooCommerce comments from the reviews you collected here — handy if another tool reads the comment tables. Safe to run repeatedly; it won’t loop or duplicate."
msgstr "از نظراتی که اینجا جمع کرده‌اید کامنت‌های بومیِ وردپرس / ووکامرس را بازسازی می‌کند — وقتی ابزارِ دیگری جدول‌های کامنت را می‌خواند مفید است. برای اجرای مکرر امن است؛ حلقه یا تکرار نمی‌سازد."

#: build/index.js:2
#, js-format
msgid "%d reviews eligible"
msgstr "%d نظرِ واجدِ شرایط"

#: build/index.js:2
#, js-format
msgid "%d already exported"
msgstr "%d از قبل برون‌بری‌شده"

#: build/index.js:2
#, js-format
msgid "Exported %d reviews to comments."
msgstr "%d نظر به کامنت‌ها برون‌بری شد."

#: build/index.js:2
msgid "Export to comments"
msgstr "برون‌بری به کامنت‌ها"

#: build/index.js:2
#, js-format
msgid "exported %d…"
msgstr "برون‌بری %d…"

#: build/index.js:2
msgid "Backup (CSV)"
msgstr "پشتیبان (CSV)"

#: build/index.js:2
msgid "Download every review as a CSV file — a spreadsheet you can keep as a backup or move to another site."
msgstr "همه‌ی نظرات را به‌صورتِ فایلِ CSV دانلود کنید — صفحه‌گسترده‌ای که می‌توانید به‌عنوانِ پشتیبان نگه دارید یا به سایتِ دیگری منتقل کنید."

#: build/index.js:2
msgid "Download CSV"
msgstr "دانلودِ CSV"

#: build/index.js:2
msgid "Failed to load."
msgstr "بارگذاری ناموفق بود."

#: build/index.js:2
msgid "Total"
msgstr "کل"

#: build/index.js:2
msgid "Moderate and reply to reviews"
msgstr "بررسی و پاسخ به نظرات"

#: build/index.js:2
msgid "See which pages and businesses get the most reviews"
msgstr "ببینید کدام صفحه‌ها و کسب‌وکارها بیشترین نظر را می‌گیرند"

#: build/index.js:2
msgid "Configure how reviews work"
msgstr "پیکربندیِ نحوه‌ی کارِ نظرات"

#: build/index.js:2
msgid "Import, export and migrate reviews"
msgstr "درون‌ریزی، برون‌بری و مهاجرتِ نظرات"
